---
import { getCollection } from 'astro:content';
import ActivityEvidence from '../components/home/ActivityEvidence.astro';
import HeroSection from '../components/home/HeroSection.astro';
import IntroSplash from '../components/home/IntroSplash.astro';
import PersonalityContact from '../components/home/PersonalityContact.astro';
import WritingSurface from '../components/home/WritingSurface.astro';
import BaseLayout from '../components/layout/BaseLayout.astro';
import SectionMarker from '../components/ui/SectionMarker.astro';
import { byDateDesc } from '../lib/content';
import { site } from '../lib/data';
import { getRandomMarginalia } from '../lib/marginalia';
import { getCurrentThread } from '../lib/parseWorklog';

const posts = byDateDesc(await getCollection('posts'));
const worklogs = await getCollection('worklogs');
const currentThread = getCurrentThread(worklogs);
const marginalia = getRandomMarginalia(posts);
const terminalStats = {
  posts: posts.length,
  tags: new Set(posts.flatMap((post) => post.data.tags)).size,
  logs: worklogs.length,
};
---

<BaseLayout title={site.name} description={site.research_oneliner}>
  <IntroSplash />

  <main class="home-page">
    <section class="home-identity home-reveal" style="--reveal-index: 0" aria-labelledby="identity-title">
      <SectionMarker id="identity-title" number="01" name="IDENTITY" tone="pink" />
      <HeroSection site={site} terminalStats={terminalStats} />
    </section>

    <div class="home-divider home-reveal" style="--reveal-index: 1" aria-hidden="true"></div>

    <div class="home-reveal" style="--reveal-index: 2">
      <WritingSurface posts={posts} />
    </div>

    <div class="home-divider home-reveal" style="--reveal-index: 3" aria-hidden="true"></div>

    <div class="home-reveal" style="--reveal-index: 4">
      <ActivityEvidence thread={currentThread} posts={posts} site={site} />
    </div>

    <div class="home-divider home-reveal" style="--reveal-index: 5" aria-hidden="true"></div>

    <div class="home-reveal" style="--reveal-index: 6">
      <PersonalityContact marginalia={marginalia} />
    </div>
  </main>
</BaseLayout>

<style>
  .home-page {
    --home-identity-min-height: clamp(520px, 33vw, 760px);
    --home-writing-panel-height: clamp(430px, 26vw, 660px);
    --home-thread-min-height: clamp(220px, 16vw, 360px);
    --home-activity-card-height: clamp(280px, 18vw, 420px);
    --home-coda-min-height: clamp(240px, 18vw, 420px);

    display: grid;
    gap: clamp(48px, 4vw, 96px);
    width: 82vw;
    margin: 0 auto;
    padding: clamp(var(--s-6), 3vw, var(--s-12)) 0 clamp(var(--s-16), 6vw, 128px);
  }

  .home-identity {
    display: grid;
    gap: var(--s-4);
  }

  :global(html.ej-intro-running) .home-reveal {
    opacity: 0;
    filter: blur(5px);
    pointer-events: none;
    transform: translate3d(0, 24px, 0) scale(0.985);
  }

  :global(html.ej-intro-complete) .home-reveal {
    animation: home-reveal-in 680ms cubic-bezier(0, 0, 0.3, 1) both;
    animation-delay: calc(var(--reveal-index, 0) * 90ms);
  }

  .home-divider {
    position: relative;
    height: 13px;
    margin: clamp(-1px, -1.3vw, -12px) 0;
    opacity: 0.75;
  }

  .home-divider::before,
  .home-divider::after {
    position: absolute;
    content: '';
  }

  .home-divider::before {
    top: 6px;
    right: 0;
    left: 0;
    height: 1px;
    background:
      linear-gradient(90deg, transparent, rgba(56, 189, 248, 0.44) 18%, rgba(244, 114, 182, 0.5) 50%, rgba(56, 189, 248, 0.32) 82%, transparent);
    box-shadow:
      0 0 10px rgba(56, 189, 248, 0.1),
      0 0 16px rgba(244, 114, 182, 0.075);
  }

  .home-divider::after {
    top: 3px;
    right: clamp(24px, 7vw, 120px);
    left: clamp(24px, 7vw, 120px);
    height: 7px;
    border-right: 1px solid rgba(244, 114, 182, 0.32);
    border-left: 1px solid rgba(125, 211, 252, 0.36);
    background:
      repeating-linear-gradient(90deg, transparent 0 22px, rgba(255, 255, 255, 0.06) 22px 23px, transparent 23px 46px);
    mask-image: linear-gradient(90deg, transparent, #000 16%, #000 84%, transparent);
  }

  @keyframes home-reveal-in {
    from {
      opacity: 0;
      filter: blur(5px);
      transform: translate3d(0, 24px, 0) scale(0.985);
    }

    to {
      opacity: 1;
      filter: blur(0);
      transform: translate3d(0, 0, 0) scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.ej-intro-complete) .home-reveal {
      animation: none;
    }
  }

  @media (max-width: 1060px) {
    .home-page {
      width: calc(100% - 32px);
      gap: var(--s-12);
    }
  }

  @media (max-width: 560px) {
    .home-page {
      width: calc(100% - 28px);
      gap: var(--s-10);
      padding-top: var(--s-6);
    }
  }
</style>
