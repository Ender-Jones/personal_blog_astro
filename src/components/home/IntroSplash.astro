<script is:inline>
  (() => {
    const key = 'enderjones:intro-splash:v1';
    const params = new URLSearchParams(window.location.search);
    const force = params.get('intro') === '1';
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let seen = false;

    try {
      seen = window.sessionStorage.getItem(key) === 'done';
    } catch {
      seen = false;
    }

    if (!reducedMotion && (!seen || force)) {
      document.documentElement.classList.add('ej-intro-running');
    }
  })();
</script>

<div class="intro-splash" data-intro-splash role="dialog" aria-label="Site introduction" aria-modal="true">
  <div class="intro-splash__copy">
    <p class="intro-splash__hi" style="--intro-delay: 0ms">Hi,</p>
    <h1 style="--intro-delay: 620ms">I am <span>Ender Jones</span>.</h1>
    <p class="intro-splash__line" style="--intro-delay: 1320ms">a Ph.D. researcher in Tokyo,</p>
    <p class="intro-splash__line" style="--intro-delay: 1980ms">teaching AI to understand what humans feel.</p>
  </div>

  <button class="intro-splash__enter" type="button" style="--intro-delay: 2760ms" data-intro-skip>ENTER ↓</button>
</div>

<script is:inline>
  (() => {
    const root = document.documentElement;
    const splash = document.querySelector('[data-intro-splash]');
    const skip = document.querySelector('[data-intro-skip]');
    const key = 'enderjones:intro-splash:v1';

    if (!root.classList.contains('ej-intro-running') || !splash) return;

    let finished = false;
    let timer = window.setTimeout(() => finish(false), 6550);

    const markSeen = () => {
      try {
        window.sessionStorage.setItem(key, 'done');
      } catch {
        // sessionStorage can be unavailable in private or locked-down contexts.
      }
    };

    const cleanup = () => {
      document.removeEventListener('keydown', onKeydown);
      splash.removeEventListener('click', onPointerSkip);
      skip?.removeEventListener('click', onButtonSkip);
    };

    function finish(fast) {
      if (finished) return;

      finished = true;
      window.clearTimeout(timer);
      markSeen();
      root.classList.add('ej-intro-exiting');

      window.setTimeout(
        () => {
          root.classList.remove('ej-intro-running', 'ej-intro-exiting');
          root.classList.add('ej-intro-complete');
          splash.remove();
          cleanup();
        },
        fast ? 120 : 420,
      );
    }

    function onKeydown(event) {
      if (event.key === 'Escape' || event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        finish(true);
      }
    }

    function onPointerSkip() {
      finish(true);
    }

    function onButtonSkip(event) {
      event.stopPropagation();
      finish(true);
    }

    document.addEventListener('keydown', onKeydown);
    splash.addEventListener('click', onPointerSkip);
    skip?.addEventListener('click', onButtonSkip);
  })();
</script>

