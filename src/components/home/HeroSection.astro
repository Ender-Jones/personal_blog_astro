---
import type { SiteData } from '../../lib/data';

type Props = {
  site: SiteData;
  terminalStats: {
    posts: number;
    tags: number;
    logs: number;
  };
};

const { site, terminalStats } = Astro.props;
const portrait = site.hero_portrait ?? site.avatar;
const identity = site.identity;
const terminalLanguages = identity.languages;
const terminalModels = identity.models.flatMap((item) => {
  if (item.toLowerCase() === 'cct-lstm') return ['CCT', 'LSTM'];
  if (item.toLowerCase() === 'multimodal fusion') return ['Multimodal fusion'];
  if (item.toLowerCase() === 'sequence modeling') return ['Sequence modeling'];
  return [item];
});
const toolOrder = ['linux', 'pytorch', 'neurokit2', 'reproducible experiments'];
const terminalTools = [...identity.tools].sort((a, b) => {
  const ai = toolOrder.indexOf(a.toLowerCase());
  const bi = toolOrder.indexOf(b.toLowerCase());
  return (ai === -1 ? Number.MAX_SAFE_INTEGER : ai) - (bi === -1 ? Number.MAX_SAFE_INTEGER : bi);
});
---

<article class="identity-console" aria-label="Identity">
  <div class="identity-terminal">
    <div class="identity-terminal__bar" aria-hidden="true">
      <span class="identity-terminal__lights">
        <span class="identity-terminal__dot identity-terminal__dot--red"></span>
        <span class="identity-terminal__dot identity-terminal__dot--yellow"></span>
        <span class="identity-terminal__dot identity-terminal__dot--green"></span>
      </span>
      <span class="identity-terminal__title">{identity.terminal_title}</span>
      <span class="identity-terminal__actions"></span>
    </div>

    <div class="identity-terminal__grid">
      <span class="line-no" aria-hidden="true">01</span>
      <p class="line-body terminal-command"><span aria-hidden="true">&gt;</span> whoami</p>

      <span class="line-no" aria-hidden="true">02</span>
      <p class="line-body terminal-kv terminal-kv--name">
        <span class="terminal-label">name:</span>
        <strong>{site.name}</strong>
      </p>

      <span class="line-no" aria-hidden="true">03</span>
      <p class="line-body terminal-kv terminal-role">
        <span class="terminal-label">role:</span>
        <b>PhD Candidate</b>
        <i>·</i>
        <em>AI</em>
        <i>/</i>
        <mark>Affective Computing</mark>
      </p>

      <span class="line-no" aria-hidden="true">04</span>
      <div class="line-body terminal-separator" aria-hidden="true"><span></span></div>

      <span class="line-no" aria-hidden="true">05</span>
      <p class="line-body terminal-command"><span aria-hidden="true">&gt;</span> grep -i thesis research.md</p>

      <span class="line-no" aria-hidden="true">06</span>
      <p class="line-body terminal-output">"teaching machines how a body feels."</p>

      <span class="line-no" aria-hidden="true">07</span>
      <div class="line-body terminal-separator" aria-hidden="true"><span></span></div>

      <span class="line-no" aria-hidden="true">08</span>
      <p class="line-body terminal-command"><span aria-hidden="true">&gt;</span> ls language/ stack/</p>

      <span class="line-no" aria-hidden="true">09</span>
      <p class="line-body terminal-kv terminal-list terminal-list--blue">
        <span class="terminal-label">langs:</span>
        {terminalLanguages.map((item, index) => (
          <><code>{item}</code>{index < terminalLanguages.length - 1 && <i>·</i>}</>
        ))}
      </p>

      <span class="line-no" aria-hidden="true">10</span>
      <p class="line-body terminal-kv terminal-list terminal-list--blue">
        <span class="terminal-label">models:</span>
        {terminalModels.map((item, index) => (
          <><code>{item}</code>{index < terminalModels.length - 1 && <i>·</i>}</>
        ))}
      </p>

      <span class="line-no" aria-hidden="true">11</span>
      <p class="line-body terminal-kv terminal-list terminal-list--teal">
        <span class="terminal-label">tools:</span>
        {terminalTools.map((item, index) => (
          <><code>{item}</code>{index < terminalTools.length - 1 && <i>·</i>}</>
        ))}
      </p>

      <span class="line-no" aria-hidden="true">12</span>
      <div class="line-body terminal-separator" aria-hidden="true"><span></span></div>

      <span class="line-no" aria-hidden="true">13</span>
      <p class="line-body terminal-command"><span aria-hidden="true">&gt;</span> wc -l content/*</p>

      <span class="line-no" aria-hidden="true">14</span>
      <p class="line-body terminal-counts">
        <a class="terminal-count terminal-count--posts" href="/posts/"><span>posts:</span> <b>{terminalStats.posts}</b></a>
        <i aria-hidden="true">·</i>
        <a class="terminal-count terminal-count--tags" href="/tags/"><span>tags:</span> <b>{terminalStats.tags}</b></a>
        <i aria-hidden="true">·</i>
        <a class="terminal-count terminal-count--logs" href="/worklog/"><span>logs:</span> <b>{terminalStats.logs}</b></a>
      </p>

      <span class="line-no" aria-hidden="true">15</span>
      <p class="line-body terminal-prompt"><span aria-hidden="true">&gt;</span> <b class="ej-blink">_</b></p>
    </div>
  </div>

  <aside class="identity-portrait" aria-label="Author portrait">
    <div class="identity-portrait__frame">
      <span class="corner corner--tl" aria-hidden="true"></span>
      <span class="corner corner--tr" aria-hidden="true"></span>
      <span class="corner corner--bl" aria-hidden="true"></span>
      <span class="corner corner--br" aria-hidden="true"></span>
      <img src={portrait} alt={`${site.name} avatar`} loading="eager" />
    </div>

    <div class="identity-portrait__caption">
      <p>"{identity.portrait_caption}"</p>
      <a href="/about/">reach_me.sh →</a>
    </div>
  </aside>
</article>

<style>
  .identity-console {
    display: grid;
    grid-template-columns: minmax(0, 2.1fr) minmax(300px, 0.9fr);
    gap: clamp(var(--s-4), 2vw, var(--s-6));
    min-height: var(--home-identity-min-height, clamp(520px, 39vw, 550px));
  }

  .identity-terminal,
  .identity-portrait {
    overflow: hidden;
    border: 1px solid rgba(148, 163, 184, 0.12);
    border-radius: var(--r-xl);
    background: rgba(5, 8, 14, 0.86);
    box-shadow:
      0 0 34px rgba(2, 8, 23, 0.54),
      inset 0 1px 0 rgba(255, 255, 255, 0.04);
    transition:
      border-color 90ms ease,
      box-shadow 90ms ease;
  }

  .identity-terminal {
    --terminal-gutter-width: 48px;
    --terminal-input-size: 15px;
    --terminal-output-size: 16px;
    --terminal-emphasis-size: 17px;
    --terminal-meta-size: 14px;
    --terminal-name-size: 20px;

    display: grid;
    overflow: hidden;
    grid-template-rows: 36px 1fr;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    background: transparent;
    box-shadow: 0 24px 60px -30px rgba(0, 0, 0, 0.8);
  }

  .identity-terminal:hover {
    border-color: rgba(255, 255, 255, 0.14);
    box-shadow: 0 24px 60px -30px rgba(0, 0, 0, 0.8);
  }

  .identity-terminal__bar {
    display: grid;
    height: 36px;
    grid-template-columns: 96px minmax(0, 1fr) 96px;
    align-items: center;
    justify-content: space-between;
    padding: 0 14px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    background: #0a0a0a;
  }

  .identity-terminal__lights {
    display: flex;
    width: 96px;
    align-items: center;
    gap: 8px;
  }

  .identity-terminal__actions {
    width: 96px;
  }

  .identity-terminal__dot {
    width: 10px;
    height: 10px;
    border-radius: 999px;
  }

  .identity-terminal__dot--red {
    background: #ff5f57;
    box-shadow: 0 0 8px rgba(255, 95, 87, 0.36);
  }

  .identity-terminal__dot--yellow {
    background: #ffbd2e;
    box-shadow: 0 0 8px rgba(255, 189, 46, 0.28);
  }

  .identity-terminal__dot--green {
    background: #28c840;
    box-shadow: 0 0 8px rgba(40, 200, 64, 0.3);
  }

  .identity-terminal__title {
    overflow: hidden;
    color: #71717a;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: var(--fw-medium);
    letter-spacing: 0.04em;
    text-align: center;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .identity-terminal__grid {
    position: relative;
    display: grid;
    grid-template-columns: var(--terminal-gutter-width) minmax(0, 1fr);
    grid-auto-rows: 28px;
    align-content: start;
    padding: 20px 24px 20px 0;
    background:
      radial-gradient(720px 340px at 78% 0%, rgba(56, 189, 248, 0.014), transparent 62%),
      rgba(5, 5, 5, 0.5);
    font-family: var(--font-mono);
  }

  .identity-terminal__grid::before {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: var(--terminal-gutter-width);
    border-right: 1px solid rgba(255, 255, 255, 0.05);
    background: rgba(3, 3, 3, 0.15);
    content: '';
  }

  .identity-terminal__grid > * {
    position: relative;
  }

  .line-no {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    height: 28px;
    padding-right: 12px;
    color: rgba(113, 113, 122, 0.72);
    font-size: var(--terminal-meta-size);
    font-weight: var(--fw-medium);
    line-height: 28px;
    text-align: right;
  }

  .line-body {
    height: 28px;
    min-width: 0;
    margin: 0;
    padding-left: 24px;
    overflow: hidden;
    color: #e4e4e7;
    font-size: var(--terminal-output-size);
    font-weight: var(--fw-regular);
    letter-spacing: 0;
    line-height: 28px;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .terminal-command span,
  .terminal-prompt span {
    color: var(--accent-pink);
    user-select: none;
  }

  .terminal-command,
  .terminal-prompt {
    font-size: var(--terminal-input-size);
  }

  .terminal-kv {
    display: flex;
    align-items: baseline;
  }

  .terminal-label {
    display: inline-block;
    width: 9ch;
    flex: 0 0 9ch;
    color: #52525b;
    font-size: var(--terminal-meta-size);
    font-weight: var(--fw-regular);
    user-select: none;
  }

  .terminal-kv--name strong {
    color: var(--accent-pink);
    font-family: var(--font-serif);
    font-size: var(--terminal-name-size);
    font-style: italic;
    font-weight: var(--fw-regular);
    letter-spacing: 0;
  }

  .terminal-role b {
    color: #e4e4e7;
    font-weight: var(--fw-regular);
  }

  .terminal-role em {
    color: var(--accent-blue);
    font-style: normal;
  }

  .terminal-role mark {
    background: transparent;
    color: var(--accent-teal);
  }

  .terminal-role i,
  .terminal-list i,
  .terminal-counts > i {
    padding: 0 0.375rem;
    color: #3f3f46;
    font-style: normal;
    user-select: none;
  }

  .terminal-output {
    padding-left: 24px;
    color: #d4d4d8;
    font-family: var(--font-serif);
    font-size: var(--terminal-output-size);
    font-style: italic;
    font-weight: var(--fw-regular);
  }

  .terminal-separator {
    display: flex;
    align-items: center;
  }

  .terminal-separator span {
    display: block;
    width: 100%;
    border-bottom: 1px dotted rgba(255, 255, 255, 0.08);
  }

  .terminal-list code {
    font-family: inherit;
    font-size: inherit;
    font-weight: var(--fw-regular);
  }

  .terminal-list--blue code {
    color: var(--accent-blue);
  }

  .terminal-list--teal code {
    color: var(--accent-teal);
  }

  .terminal-counts {
    display: flex;
    align-items: baseline;
  }

  .terminal-count {
    color: #71717a;
  }

  .terminal-count:hover span {
    color: #d4d4d8;
  }

  .terminal-count b {
    font-variant-numeric: tabular-nums;
    font-weight: var(--fw-medium);
  }

  .terminal-count--posts b {
    color: var(--accent-pink);
  }

  .terminal-count--tags b {
    color: var(--accent-blue);
  }

  .terminal-count--logs b {
    color: var(--accent-teal);
  }

  .terminal-prompt b {
    color: #d4d4d8;
    font-weight: var(--fw-bold);
  }

  @keyframes ej-blink {
    0%,
    49% {
      opacity: 1;
    }

    50%,
    100% {
      opacity: 0;
    }
  }

  .ej-blink {
    animation: ej-blink 1.05s steps(1, end) infinite;
  }

  .identity-portrait {
    display: grid;
    grid-template-rows: 1fr auto;
    padding: clamp(var(--s-4), 2vw, var(--s-5));
    border-color: rgba(148, 163, 184, 0.12);
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.018), rgba(255, 255, 255, 0.004)),
      rgba(6, 9, 16, 0.94);
  }

  .identity-portrait:hover {
    border-color: rgba(148, 163, 184, 0.2);
    box-shadow:
      0 0 34px rgba(2, 8, 23, 0.54),
      0 0 18px rgba(148, 163, 184, 0.055),
      inset 0 1px 0 rgba(255, 255, 255, 0.05);
  }

  .identity-portrait__frame {
    position: relative;
    height: 100%;
    min-height: 0;
    overflow: hidden;
    border: 1px solid rgba(148, 163, 184, 0.14);
    border-radius: var(--r-md);
    background: #070a11;
    box-shadow:
      0 0 22px rgba(2, 8, 23, 0.26),
      inset 0 0 0 1px rgba(255, 255, 255, 0.04);
    transition:
      border-color 90ms ease,
      box-shadow 90ms ease;
  }

  .identity-portrait:hover .identity-portrait__frame {
    border-color: rgba(148, 163, 184, 0.21);
    box-shadow:
      0 0 22px rgba(148, 163, 184, 0.055),
      inset 0 0 0 1px rgba(255, 255, 255, 0.05);
  }

  .identity-portrait__frame::after {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(3, 7, 18, 0.1), rgba(3, 7, 18, 0.38)),
      radial-gradient(420px 220px at 50% 0%, rgba(56, 189, 248, 0.06), transparent 68%);
    content: '';
    pointer-events: none;
  }

  .identity-portrait__frame img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    min-height: 0;
    object-fit: cover;
    object-position: center center;
    filter: brightness(0.74) saturate(0.54) contrast(1.05);
  }

  .corner {
    position: absolute;
    z-index: 2;
    width: 24px;
    height: 24px;
    opacity: 0.72;
  }

  .corner--tl {
    top: 16px;
    left: 16px;
    border-top: 1px solid rgba(244, 114, 182, 0.82);
    border-left: 1px solid rgba(244, 114, 182, 0.82);
    box-shadow:
      -5px -5px 12px -8px rgba(244, 114, 182, 0.78),
      inset 5px 5px 12px -10px rgba(244, 114, 182, 0.64);
  }

  .corner--tr {
    top: 16px;
    right: 16px;
    border-top: 1px solid rgba(56, 189, 248, 0.82);
    border-right: 1px solid rgba(56, 189, 248, 0.82);
    box-shadow:
      5px -5px 12px -8px rgba(56, 189, 248, 0.72),
      inset -5px 5px 12px -10px rgba(56, 189, 248, 0.58);
  }

  .corner--bl {
    bottom: 16px;
    left: 16px;
    border-bottom: 1px solid rgba(56, 189, 248, 0.82);
    border-left: 1px solid rgba(56, 189, 248, 0.82);
    box-shadow:
      -5px 5px 12px -8px rgba(56, 189, 248, 0.72),
      inset 5px -5px 12px -10px rgba(56, 189, 248, 0.58);
  }

  .corner--br {
    right: 16px;
    bottom: 16px;
    border-right: 1px solid rgba(244, 114, 182, 0.82);
    border-bottom: 1px solid rgba(244, 114, 182, 0.82);
    box-shadow:
      5px 5px 12px -8px rgba(244, 114, 182, 0.78),
      inset -5px -5px 12px -10px rgba(244, 114, 182, 0.64);
  }

  .identity-portrait__caption {
    display: grid;
    gap: var(--s-3);
    padding: var(--s-4) 8px 2px;
    border-top: 1px solid rgba(148, 163, 184, 0.08);
  }

  .identity-portrait__caption p {
    margin: 0;
    color: #d4d4d8;
    font-family: var(--font-serif);
    font-size: clamp(15px, 1.25vw, 18px);
    font-style: italic;
    line-height: 1.3;
  }

  .identity-portrait__caption a {
    width: max-content;
    color: var(--accent-blue);
    font-family: var(--font-mono);
    font-size: clamp(13px, 1.15vw, 17px);
    font-weight: var(--fw-semibold);
    letter-spacing: 0.05em;
    text-shadow:
      0 0 9px rgba(56, 189, 248, 0.38),
      0 0 20px rgba(56, 189, 248, 0.16);
    transition:
      color 150ms ease,
      text-shadow 150ms ease;
  }

  .identity-portrait__caption a:hover {
    color: var(--accent-pink);
    text-shadow:
      0 0 10px rgba(244, 114, 182, 0.48),
      0 0 24px rgba(244, 114, 182, 0.2);
  }

  @media (max-width: 1120px) {
    .identity-console {
      grid-template-columns: 1fr;
    }

    .identity-portrait {
      grid-template-columns: minmax(220px, 0.8fr) minmax(0, 1fr);
      grid-template-rows: auto;
      align-items: stretch;
    }

    .identity-portrait__frame img {
      min-height: 320px;
    }

    .identity-portrait__caption {
      align-content: end;
      border-top: 0;
      border-left: 1px solid rgba(255, 255, 255, 0.08);
      padding: var(--s-5);
    }
  }

  @media (max-width: 720px) {
    .identity-console {
      min-height: 0;
    }

    .identity-terminal {
      --terminal-gutter-width: 42px;
      --terminal-input-size: 14px;
      --terminal-output-size: 15px;
      --terminal-emphasis-size: 16px;
      --terminal-meta-size: 12px;
      --terminal-name-size: 19px;

      grid-template-rows: 36px 1fr;
      border-radius: 8px;
    }

    .identity-terminal__bar {
      grid-template-columns: 58px minmax(0, 1fr) 58px;
      padding: 0 12px;
    }

    .identity-terminal__lights,
    .identity-terminal__actions {
      width: 58px;
    }

    .identity-terminal__dot {
      width: 10px;
      height: 10px;
    }

    .identity-terminal__title {
      font-size: 10px;
    }

    .identity-terminal__grid {
      grid-auto-rows: 28px;
      padding: var(--s-5) var(--s-4) var(--s-5) 0;
    }

    .line-no {
      font-size: 12px;
      padding-right: 10px;
    }

    .line-body {
      padding-left: var(--s-4);
      line-height: 28px;
    }

    .identity-portrait {
      grid-template-columns: 1fr;
      padding: var(--s-3);
      border-radius: var(--r-lg);
    }

    .identity-portrait__frame {
      aspect-ratio: 1 / 1;
    }

    .identity-portrait__frame img {
      min-height: 0;
    }

    .identity-portrait__caption {
      border-top: 1px solid rgba(255, 255, 255, 0.08);
      border-left: 0;
      padding: var(--s-4) var(--s-2) var(--s-1);
    }
  }
</style>
